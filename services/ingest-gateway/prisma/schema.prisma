datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ChangeEvent {
  id        String   @id @default(uuid())
  type      String
  service   String
  revision  String
  ts        DateTime
  author    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([service, ts])
  @@index([type])
  @@map("change_events")
}

model IngestedAlert {
  id          String    @id @default(uuid())
  tenantId    String    @default("local") @map("tenant_id")
  fingerprint String
  name        String
  service     String
  severity    String
  status      String
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  labels      Json      @default("{}")
  annotations Json      @default("{}")
  rawPayload  Json?     @map("raw_payload")
  processed   Boolean   @default(false)
  incidentId  String?   @map("incident_id")
  receivedAt  DateTime  @default(now()) @map("received_at")

  @@index([service, startsAt])
  @@index([fingerprint, status])
  @@index([processed])
  @@index([tenantId])
  @@map("ingested_alerts")
}

model Incident {
  id         String   @id @default(uuid())
  tenantId   String   @default("local") @map("tenant_id")
  title      String
  severity   String
  status     String
  startedAt  DateTime @map("started_at")
  detectedAt DateTime @map("detected_at")
  signals    Json     @default("[]")
  enrichment Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  timeline IncidentTimelineEvent[]

  @@index([tenantId, status])
  @@index([startedAt])
  @@map("incidents")
}

model IncidentTimelineEvent {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  ts         DateTime
  actor      String
  action     String
  detail     String?
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, ts])
  @@map("incident_timeline_events")
}
