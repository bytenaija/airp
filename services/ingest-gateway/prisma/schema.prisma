datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ChangeEvent {
  id        String   @id @default(uuid())
  type      String
  service   String
  revision  String
  ts        DateTime
  author    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([service, ts])
  @@index([type])
  @@map("change_events")
}

model IngestedAlert {
  id          String    @id @default(uuid())
  tenantId    String    @default("local") @map("tenant_id")
  fingerprint String
  name        String
  service     String
  severity    String
  status      String
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  labels      Json      @default("{}")
  annotations Json      @default("{}")
  rawPayload  Json?     @map("raw_payload")
  processed   Boolean   @default(false)
  incidentId  String?   @map("incident_id")
  receivedAt  DateTime  @default(now()) @map("received_at")

  @@index([service, startsAt])
  @@index([fingerprint, status])
  @@index([processed])
  @@index([tenantId])
  @@map("ingested_alerts")
}

model Incident {
  id         String   @id @default(uuid())
  tenantId   String   @default("local") @map("tenant_id")
  title      String
  severity   String
  status     String
  startedAt  DateTime @map("started_at")
  detectedAt DateTime @map("detected_at")
  signals    Json     @default("[]")
  enrichment Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  timeline IncidentTimelineEvent[]

  @@index([tenantId, status])
  @@index([startedAt])
  @@map("incidents")
}

model IncidentTimelineEvent {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  ts         DateTime
  actor      String
  action     String
  detail     String?
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, ts])
  @@map("incident_timeline_events")
}

model PolicyAuditLog {
  id                String   @id @default(uuid())
  tenantId          String   @default("local") @map("tenant_id")
  timestamp         DateTime @default(now())
  eventType         String   @map("event_type")
  identity          String
  policyVersion     String   @map("policy_version")
  targetId          String   @map("target_id")
  actionOrDecision  String   @map("action_or_decision")
  autoMergeEligible Boolean? @map("auto_merge_eligible")
  requiredApprovals Json     @default("[]") @map("required_approvals")
  reasons           Json     @default("[]")
  advisory          Json?
  metadata          Json?    @default("{}")

  @@index([tenantId, eventType])
  @@index([targetId])
  @@index([timestamp])
  @@map("policy_audit_logs")
}
