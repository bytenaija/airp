{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Agent Self-RED Metrics (Rate, Errors, Duration)",
      "type": "row"
    },
    {
      "title": "Investigations Started (Rate / sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (severity) (max without (instance) (rate(airp_investigations_started_total[1m])))",
          "legendFormat": "{{severity}} started"
        }
      ]
    },
    {
      "title": "Investigations Errored (Errors / sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (severity) (max without (instance) (rate(airp_investigations_errored_total[1m])))",
          "legendFormat": "{{severity}} errors"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "custom": { "axisSoftMax": 0.02 } },
        "overrides": []
      }
    },
    {
      "title": "Time to Diagnosis (p90 Duration)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum by (le) (max without (instance) (rate(airp_time_to_diagnosis_seconds_bucket[5m]))))",
          "legendFormat": "p90 duration (s)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Tool Execution and Diagnosis Confidence",
      "type": "row"
    },
    {
      "title": "Tool Calls Total by Tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tool) (max without (instance) (rate(airp_tool_calls_total[1m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "title": "Diagnosis Confidence Distribution",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (le) (max without (instance) (increase(airp_confidence_distribution_bucket[$__range])))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "vertical",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "valueMode": "color",
        "namePlacement": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "displayName": "le ${__field.labels.le}"
        },
        "overrides": []
      },
      "description": "Diagnoses per confidence bucket over the selected time range (upper bound le)."
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 8,
      "title": "LLM Tokens and Cost Accounting",
      "type": "row"
    },
    {
      "title": "LLM Tokens Consumed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (max without (instance) (rate(airp_llm_tokens_total[1m])))",
          "legendFormat": "{{model}} tokens/s"
        }
      ]
    },
    {
      "title": "LLM Cumulative Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(max without (instance) (airp_llm_cost_dollars))",
          "legendFormat": "Total LLM Cost ($)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 4, "min": 0 },
        "overrides": []
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["airp", "agent", "red", "llm"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["2s", "5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "AIRP - Agent Self-RED Metrics & Operational Dashboard",
  "uid": "airp-agent-red",
  "version": 1
}
