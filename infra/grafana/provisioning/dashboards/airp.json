  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Agent Self-RED Metrics (Rate, Errors, Duration)",
      "type": "row"
    },
    {
      "title": "Investigations Started (Rate / sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (severity) (rate(airp_investigations_started_total[1m]))",
          "legendFormat": "{{severity}} started"
        }
      ]
    },
    {
      "title": "Investigations Errored (Errors / sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (severity) (rate(airp_investigations_errored_total[1m]))",
          "legendFormat": "{{severity}} errors"
        }
      ]
    },
    {
      "title": "Time to Diagnosis (p90 Duration)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(airp_time_to_diagnosis_seconds_bucket[5m])))",
          "legendFormat": "p90 duration (s)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Tool Execution and Diagnosis Confidence",
      "type": "row"
    },
    {
      "title": "Tool Calls Total by Tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tool) (rate(airp_tool_calls_total[1m]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "title": "Diagnosis Confidence Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (le) (increase(airp_confidence_distribution_bucket[$__range]))",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 8,
      "title": "LLM Tokens and Cost Accounting",
      "type": "row"
    },
    {
      "title": "LLM Tokens Consumed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (rate(airp_llm_tokens_total[1m]))",
          "legendFormat": "{{model}} tokens/s"
        }
      ]
    },
    {
      "title": "LLM Cumulative Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(airp_llm_cost_dollars)",
          "legendFormat": "Total LLM Cost ($)"
        }
      ]
    }
